@model CloudSupportSystem.Models.SupportTicket

@{
    ViewData["Title"] = "Create Ticket";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="mb-4">
        <h1 class="fw-bold">Create Support Ticket</h1>
        <p class="text-muted">
            Describe your problem and our support team will help you.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-controller="SupportTickets"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UserName"
                           class="form-label fw-semibold">
                        Your Name
                    </label>

                    <input asp-for="UserName"
                           class="form-control"
                           placeholder="Enter your name" />

                    <span asp-validation-for="UserName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Subject"
                           class="form-label fw-semibold">
                        Subject
                    </label>

                    <input asp-for="Subject"
                           class="form-control"
                           placeholder="For example: Cannot log in" />

                    <span asp-validation-for="Subject"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Describe your problem..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Priority"
                           class="form-label fw-semibold">
                        Priority
                    </label>

                    <select asp-for="Priority" class="form-select">
                        <option value="Low">Low</option>
                        <option value="Medium" selected>Medium</option>
                        <option value="High">High</option>
                    </select>

                    <span asp-validation-for="Priority"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Submit Ticket
                    </button>

                    <a asp-controller="SupportTickets"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
