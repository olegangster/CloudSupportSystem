@model CloudSupportSystem.Models.SupportTicket

@{
    ViewData["Title"] = "Ticket Details";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Ticket #@Model.Id</h1>
            <p class="text-muted mb-0">Support request details</p>
        </div>

        <a asp-controller="SupportTickets"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Tickets
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h3 class="fw-bold mb-3">@Model.Subject</h3>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>User:</strong>
                    <span>@Model.UserName</span>
                </div>

                <div class="col-md-6">
                    <strong>Created:</strong>
                    <span>
                        @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                </div>
            </div>

            <hr />

            <h5>Description</h5>
            <p style="white-space: pre-wrap;">@Model.Description</p>

            <hr />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <strong>Priority:</strong>

                    @if (Model.Priority == "High")
                    {
                        <span class="badge bg-danger">High</span>
                    }
                    else if (Model.Priority == "Medium")
                    {
                        <span class="badge bg-warning text-dark">Medium</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Low</span>
                    }
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Current status:</strong>

                    @if (Model.Status == "Resolved")
                    {
                        <span class="badge bg-success">Resolved</span>
                    }
                    else if (Model.Status == "In Progress")
                    {
                        <span class="badge bg-primary">In Progress</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">New</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">Change Status</h4>

            <form asp-controller="SupportTickets"
                  asp-action="ChangeStatus"
                  method="post">

                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label for="status" class="form-label">
                        New status
                    </label>

                    <select id="status"
                            name="status"
                            class="form-select">

                        <option value="New"
                                selected="@(Model.Status == "New")">
                            New
                        </option>

                        <option value="In Progress"
                                selected="@(Model.Status == "In Progress")">
                            In Progress
                        </option>

                        <option value="Resolved"
                                selected="@(Model.Status == "Resolved")">
                            Resolved
                        </option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Update Status
                </button>
            </form>
        </div>
    </div>
</div>
