@model IEnumerable<CloudSupportSystem.Models.SupportTicket>

@{
    ViewData["Title"] = "Support Tickets";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Support Tickets</h1>
            <p class="text-muted mb-0">
                Manage technical support requests
            </p>
        </div>

        <a asp-controller="SupportTickets"
           asp-action="Create"
           class="btn btn-primary">
            + Create Ticket
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No support tickets yet. Create your first ticket!
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>User</th>
                            <th>Subject</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var ticket in Model)
                        {
                            <tr>
                                <td>#@ticket.Id</td>
                                <td>@ticket.UserName</td>
                                <td>@ticket.Subject</td>
                                <td>
                                    @if (ticket.Priority == "High")
                                    {
                                        <span class="badge bg-danger">High</span>
                                    }
                                    else if (ticket.Priority == "Medium")
                                    {
                                        <span class="badge bg-warning text-dark">Medium</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Low</span>
                                    }
                                </td>
                                <td>
                                    @if (ticket.Status == "Resolved")
                                    {
                                        <span class="badge bg-success">Resolved</span>
                                    }
                                    else if (ticket.Status == "In Progress")
                                    {
                                        <span class="badge bg-primary">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">New</span>
                                    }
                                </td>
                                <td>
                                    @ticket.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    <a asp-controller="SupportTickets"
                                       asp-action="Details"
                                       asp-route-id="@ticket.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
